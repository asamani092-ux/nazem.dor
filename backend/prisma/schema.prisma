generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_MASTER
  MASTER
  MANAGER
  TEACHER
}

enum EntityStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CurriculumType {
  TIBYAN
  QARI
  BOTH
}

enum AlertKind {
  NOTICE
  VISIT
}

model User {
  id                 String       @id @default(cuid())
  phone              String       @unique
  passwordHash       String
  name               String
  role               Role
  status             EntityStatus @default(ACTIVE)
  mustChangePassword Boolean      @default(true)
  darId              String?
  classId            String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  dar   Dar?   @relation(fields: [darId], references: [id])
  class Class? @relation(fields: [classId], references: [id])

  supervisedDars Dar[] @relation("SupervisorDars")

  @@index([role, status])
  @@index([darId])
}

model TeacherNotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  createdAt      DateTime @default(now())

  notification TeacherNotification @relation(fields: [notificationId], references: [id])

  @@unique([notificationId, userId])
  @@index([userId])
}

model Dar {
  id           String         @id @default(cuid())
  name         String
  curriculum   CurriculumType
  managerName  String
  managerPhone String
  location     String?
  status       EntityStatus   @default(ACTIVE)
  supervisorId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  supervisor User? @relation("SupervisorDars", fields: [supervisorId], references: [id])

  users           User[]
  classes         Class[]
  students        Student[]
  alerts          Alert[]
  exams           Exam[]
  notifications   TeacherNotification[]
  trackings       DailyTracking[]
  lessonStates    LessonTracked[]
  examGrades      ExamGrade[]
  alertReads      AlertRead[]
  weekAttachments WeekAttachment[]

  @@index([status])
  @@index([name])
  @@index([supervisorId])
}

model Class {
  id           String       @id @default(cuid())
  darId        String
  name         String
  level        String
  teacherName  String
  teacherPhone String
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  dar             Dar                   @relation(fields: [darId], references: [id])
  users           User[]
  students        Student[]
  notifications   TeacherNotification[]
  trackings       DailyTracking[]
  lessonStates    LessonTracked[]
  examGrades      ExamGrade[]
  weekAttachments WeekAttachment[]

  @@index([darId, status])
  @@index([teacherPhone])
}

model WeekAttachment {
  id        String   @id @default(cuid())
  darId     String
  classId   String
  week      Int
  url       String
  fileName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dar   Dar   @relation(fields: [darId], references: [id])
  class Class @relation(fields: [classId], references: [id])

  @@unique([classId, week])
  @@index([darId, week])
}

model Student {
  id          String       @id @default(cuid())
  darId       String
  classId     String
  name        String
  parentPhone String
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  dar        Dar             @relation(fields: [darId], references: [id])
  class      Class           @relation(fields: [classId], references: [id])
  trackings  DailyTracking[]
  examGrades ExamGrade[]

  @@index([darId, classId, status])
  @@index([classId, status])
}

model CurriculumPlan {
  id           String @id @default(cuid())
  level        String
  week         Int
  day          String
  educational  String
  homework     String
  tarbawi      String @default("")

  @@unique([level, week, day])
  @@index([level, week])
}

model CurriculumLevel {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alert {
  id          String    @id @default(cuid())
  kind        AlertKind @default(NOTICE)
  darId       String?
  title       String
  content     String
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())

  dar Dar? @relation(fields: [darId], references: [id])

  @@index([darId, createdAt])
  @@index([darId, scheduledAt])
}

model AlertRead {
  id        String   @id @default(cuid())
  darId     String
  alertId   String
  createdAt DateTime @default(now())

  dar Dar @relation(fields: [darId], references: [id])

  @@unique([darId, alertId])
  @@index([darId])
}

model Exam {
  id        String   @id @default(cuid())
  title     String
  darId     String?
  examDate  DateTime
  link      String
  maxScore  Int      @default(100)
  notes     String?
  createdAt DateTime @default(now())

  dar    Dar?        @relation(fields: [darId], references: [id])
  grades ExamGrade[]

  @@index([darId, examDate])
}

model TeacherNotification {
  id        String   @id @default(cuid())
  darId     String
  classId   String?
  title     String
  content   String
  createdAt DateTime @default(now())

  dar   Dar                       @relation(fields: [darId], references: [id])
  class Class?                    @relation(fields: [classId], references: [id])
  reads TeacherNotificationRead[]

  @@index([darId, classId, createdAt])
}

model DailyTracking {
  id           String   @id @default(cuid())
  darId        String
  classId      String
  studentId    String
  dateStr      String
  week         Int
  day          String
  attendance   String
  homework     String
  educational  String
  tarbawi      String   @default("-")
  attachment   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dar     Dar     @relation(fields: [darId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId, week, day])
  @@index([darId, classId, week])
  @@index([studentId])
}

model LessonTracked {
  id      String @id @default(cuid())
  darId   String
  classId String
  week    Int
  day     String

  dar   Dar   @relation(fields: [darId], references: [id])
  class Class @relation(fields: [classId], references: [id])

  @@unique([classId, week, day])
  @@index([darId, classId, week])
}

model ExamGrade {
  id          String   @id @default(cuid())
  darId       String
  classId     String
  examId      String
  examTitle   String
  studentId   String
  studentName String
  score       String
  note        String?
  gradedAt    DateTime @default(now())

  dar     Dar     @relation(fields: [darId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([classId, examId])
  @@index([studentId])
  @@unique([classId, examId, studentId])
}
